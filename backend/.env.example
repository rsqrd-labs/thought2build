# Database
DATABASE_URL=postgresql+asyncpg://placeholder_user:placeholder_pass@placeholder_host:5432/thought2build
REDIS_URL=rediss://default:placeholder_pass@placeholder_host:6380

# Scalability / capacity (scalability audit P0 — all OPTIONAL, sane defaults in
# config.py; shown here so the knobs are discoverable). See docs/SCALABILITY_AUDIT.md.
#
# F9 — DB fast-fail + server-side guards (postgres engine only; a sqlite test URL
# ignores the server_settings). DB_POOL_TIMEOUT: seconds a checkout waits for a
# free pooled connection before failing (5s ⇒ a saturated pool fast-fails a
# retryable error instead of blocking SQLAlchemy's default 30s). The two
# *_TIMEOUT_MS bound a runaway query / a connection left idle-in-transaction
# (0 disables either).
DB_POOL_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=300000
#
# F8 — bound + health-check the shared Redis pool. Every request touches Redis
# (rate limiting, caches, admission), so an unbounded pool can balloon toward
# Redis maxclients under a burst; health checks recycle a connection left stale
# after a failover instead of handing it out.
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=2.0
REDIS_HEALTH_CHECK_INTERVAL=30
LLM_PROMPT_CACHE_ENABLED=true
# OpenAI prompt-cache retention: memory (default) or 24h (extended application
# state; do not enable for Zero Data Retention projects).
OPENAI_PROMPT_CACHE_RETENTION=memory
#
# F1 — admission control on the core generate/regenerate path. The per-process
# limiter is the primary valve (one worker cannot self-immolate); the per-user
# cap is a cross-instance Redis lease; the rate tier is the HTTP-native 429.
# 0 disables any one of them.
MAX_CONCURRENT_GENERATIONS_PER_PROCESS=4
MAX_CONCURRENT_GENERATIONS_PER_USER=3
# A chunked artifact can issue several simultaneous LLM calls. This is the
# worker-local socket/RPM bulkhead and must stay positive.
MAX_CONCURRENT_PROVIDER_CALLS_PER_PROCESS=8
GENERATION_ADMISSION_LEASE_TTL_SECONDS=720
GENERATION_RATE_PER_MINUTE=10
GENERATION_RATE_WINDOW_SECONDS=60
# Paid generation runs on the durable BULK worker lane (`arq worker.WorkerSettings`).
# Production/staging refuse to charge for a cache-miss run unless a generation-capable
# worker heartbeat is live, so a dead worker fleet never takes credits for work that
# will not run. Readiness is liveness: a worker on a different deploy revision from the
# API still counts (and logs `generation.worker_revision_mismatch`), because `backend`
# and `worker` deploy independently. Set the strict flag only where they move atomically.
GENERATION_WORKER_READINESS_REQUIRED=true
GENERATION_WORKER_REVISION_MATCH_REQUIRED=false
#
# F2 — global (Redis-coordinated) provider budget + 429-aware backoff. The two
# PROVIDER_MAX_* ceilings count ONLY the core generate/regenerate path against
# the shared platform key (storyboard/increment/harness-patch are governed by
# their own rate tiers and are NOT counted here). In-flight ships at a safe 4;
# RPM ships at 0 (unlimited) until the real per-org limits are measured (audit
# §F2/§6). The 429-aware backoff remains the final protection. A 429
# is retried in place on the SAME tier, then may fail over to another configured
# provider after its bounded retry budget is exhausted.
PROVIDER_MAX_INFLIGHT_GENERATIONS=4
PROVIDER_MAX_GENERATIONS_PER_MINUTE=0
PROVIDER_RATE_LIMIT_MAX_RETRIES=3
PROVIDER_RATE_LIMIT_BACKOFF_BASE_SECONDS=2.0
PROVIDER_RATE_LIMIT_BACKOFF_MAX_SECONDS=30.0
# Durable Spec/Plan/Harness/Tasks lifecycle. The total deadline and finalisation
# reserve are fixed product contracts; provider calls/idle gaps are maxima.
STAGE_GENERATION_DEADLINE_SECONDS=600
STAGE_GENERATION_FINALISE_RESERVE_SECONDS=30
# Each attempt is shorter than half the 570-second provider budget, preserving
# time for a real alternate-provider attempt and terminal persistence.
STAGE_PROVIDER_CALL_TIMEOUT_SECONDS=240
STAGE_PROVIDER_IDLE_TIMEOUT_SECONDS=240
STAGE_RETRY_MIN_REMAINING_SECONDS=120
STAGE_GENERATION_CANCEL_POLL_SECONDS=1.0
STAGE_GENERATION_CANCEL_DB_POLL_SECONDS=5.0
STAGE_TECHNOLOGY_CHECK_TIMEOUT_SECONDS=10
STAGE_TECHNOLOGY_CHECK_STALE_SECONDS=30
#
# ---- Scalability audit P1 (horizontal scale-out) — see docs/RUNBOOK.md §15/§16 ----
#
# F3 — transaction-pooler (PgBouncer) compatibility. Leave 0 for a direct
# Postgres connection (byte-identical to today). Set to 1 ONLY when a
# transaction-mode pooler is in front of Postgres: it disables asyncpg's
# prepared-statement caches and uses unique statement names so statements routed
# across pooled backends never collide. NOTE: in pooler mode the F9
# statement_timeout / idle_in_transaction guards above are stripped by the pooler
# (they are connection startup params) — set them at the Postgres ROLE level
# instead (RUNBOOK §15).
DB_TRANSACTION_POOLER_MODE=0
#
# F4 — API worker count (read by gunicorn.conf.py). Default 2 (the prior
# hardcoded value); raise toward ~2*cores+1 ONLY after a pooler (F3) is in front,
# or more workers × the per-process pool will crowd Postgres max_connections.
# COST LEVER (pre-launch / low traffic): set to 1 on Railway to halve the API
# service's resident memory — memory is the dominant Railway cost, and one async
# uvicorn worker handles pre-launch concurrency fine. Trade-off: no in-process
# redundancy (a worker crash = brief outage till respawn; deploy restarts have no
# second worker to cover the swap). Revert to 2 once real traffic arrives. See
# docs/GO_LIVE_RUNBOOK.md Phase 1.
WEB_CONCURRENCY=2
# WEB_GRACEFUL_TIMEOUT=30   # seconds a graceful restart waits for in-flight reqs
#
# F6 — bound the post-`done` background-task fan-out. The advisory work (eval
# score + critic judge + Demo-Day verifier) shares this concurrency ceiling so it
# cannot starve live generation streams; 0 disables the gate (unbounded). The
# soft-max emits a high-water WARNING per registry but never drops a task.
MAX_CONCURRENT_ADVISORY_TASKS=12
BACKGROUND_TASKS_SOFT_MAX=200
#
# ---- Scalability audit P2 (tail latency & polish) — see docs/RUNBOOK.md §17 ----
#
# F7 — CPU offload. bleach/regex-validator/difflib passes over large payloads are
# dispatched to a small dedicated thread pool so they cannot stall the event
# loop; inputs under CPU_OFFLOAD_MIN_CHARS run inline (the dispatch round-trip
# would cost more than the pass). Set MIN_CHARS huge to force everything inline
# (disable offload) or 0 to offload every call. Watch
# thought2build_event_loop_lag_seconds to validate.
CPU_OFFLOAD_MAX_WORKERS=4
CPU_OFFLOAD_MIN_CHARS=4096
#
# PDF export render pool (WeasyPrint, CPU-bound, isolated from the CPU-offload
# and Langfuse pools). Default 2; raise only if PDF export becomes a hot path —
# the per-tier rate limit caps admission separately. Clamped to >= 1.
PDF_EXPORT_MAX_WORKERS=2
#
# Public share payload cache. GET /public/{slug} responses are cached in Redis
# for this many seconds so scraper/viewer bursts stay off the Postgres pool
# (positives only — 404s are never cached; the entry is evicted immediately on
# disable/rotate/re-enable). Keep within the Cache-Control max-age the response
# already advertises (60s). 0 disables the cache; Redis errors fail open to the
# DB read.
PUBLIC_SHARE_CACHE_TTL_SECONDS=60

# ---- Construction-verifier enforcement — see docs/RUNBOOK.md §13.5 ----
# The verifier ("if you implement every task, do you get a working thing?") always
# RUNS and always reports its gaps in CONSTRUCTION_REPORT.md and the workspace
# badge. These two flags decide only whether a check may flip `verified` to false.
# Both ship false so a new check can be measured against real generations before
# it can turn an already-green package red — the checks join on `Plan refs` /
# `Harness refs` citations that the tasks prompts do not yet mandate, and those
# prompt edits ride a golden-corpus gate. Flip after that release clears the gate.
# Env-only, reversible, no redeploy. Neither flag can block or slow a generation:
# the verifier is detached and runs after the artifact is delivered and charged.
DEMO_DAY_PLAN_COVERAGE_ENFORCED=false
STANDARD_CONSTRUCTION_VERIFIER_ENFORCED=false

# ---- Data retention & purging (issue #43) — see docs/RUNBOOK.md §18 ----
# Two keys must turn before ANYTHING deletes: the master enable AND dry_run=False,
# and each tier's own flag. On a fresh deploy the sampler + counting run but
# nothing is deleted. RETENTION_ENABLED=false disables everything incl. the
# sampler (the total backout). Windows are knobs so staging can run 1-day windows.
RETENTION_ENABLED=true
RETENTION_DRY_RUN=true
RETENTION_TIER1_PURGE_ENABLED=false
RETENTION_TIER2_PURGE_ENABLED=false
RETENTION_TIER3_PURGE_ENABLED=false
RETENTION_PURGE_BATCH_SIZE=1000
RETENTION_MAX_ROWS_PER_RUN=50000
# Tier 1 — telemetry TTL + failed-row windows (days). The 180d cost-events window
# sits far above the 28d output-budget analysis lookback (issue #26).
RETENTION_COST_EVENTS_DAYS=180
RETENTION_EVAL_RESULTS_DAYS=180
RETENTION_FAILED_BATCH_JOBS_DAYS=30
RETENTION_FAILED_PUSHES_DAYS=90
# Tier 2 — content keep-N (the byte win). N is a product policy knob (it truncates
# visible version/diff history beyond N); prune only rows older than the min-age.
RETENTION_STAGE_VERSIONS_KEEP=20
RETENTION_STAGE_VERSIONS_MIN_AGE_DAYS=90
RETENTION_STORYBOARDS_KEEP=5
RETENTION_STORYBOARDS_MIN_AGE_DAYS=90
# Tier 3 — workspace trash windows (days). Acked (dialog-confirmed) deletes use
# the short trash window; legacy/un-acked rows wait the conservative one. In prod
# with TIER3 on, validate_production_settings requires trash>=7 and legacy>=90.
RETENTION_TRASH_DAYS=30
RETENTION_LEGACY_ARCHIVED_DAYS=180
# Phase 0 size sampler (hourly, read-only). Also gated by RETENTION_ENABLED.
RETENTION_TABLE_STATS_ENABLED=true

# Auth
JWT_PRIVATE_KEY="placeholder-private-key"
JWT_PUBLIC_KEY="placeholder-public-key"
GOOGLE_CLIENT_ID=placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder-google-client-secret
FRONTEND_URL=http://localhost:5173

# Comma-separated Host allowlist enforced by TrustedHostMiddleware in
# PRODUCTION only (F3 — issue #42). REQUIRED in production; leave blank in
# dev/CI (the middleware is not added, so local/compose flows on any host work).
# Include the app's public host and the platform internal healthcheck host; a
# wildcard entry ("*.example.com") matches subdomains.
# e.g. ALLOWED_HOSTS=api.thought2build.com,*.up.railway.app
ALLOWED_HOSTS=

# Path prefixes where CSRF replay protection fails CLOSED on a Redis outage
# (F2 — issue #42). Everywhere else fails open so a Redis blip cannot take down
# all authenticated mutations. Default protects billing + auth mutations.
CSRF_FAIL_CLOSED_PREFIXES=/billing,/auth

# LLM Providers
#
# Anthropic/Claude is the platform's funded provider: Claude Opus 5 runs
# full-artifact generation (the four core stages, full regenerate and the
# harness gap-patch) and Claude Haiku 4.5 runs every cheap path (judge, eval,
# summary, focused/section refine, storyboard, increment). ANTHROPIC_API_KEY is
# therefore the one you actually need.
#
# Routing skips any provider whose key is blank or starts with "placeholder-",
# so leaving OpenAI/Google as placeholders keeps them cataloged but
# unreachable. Give one of them a real key only if you want a fallback for when
# Anthropic's circuit breaker opens.
ANTHROPIC_API_KEY=placeholder-anthropic-api-key
OPENAI_API_KEY=placeholder-openai-api-key
GOOGLE_API_KEY=placeholder-google-api-key

# OpenRouter (issue #152) — a FOURTH, OPTIONAL provider fronting DeepSeek V4
# through a single OpenAI-compatible endpoint. The ladder is all-DeepSeek and
# every request prefers DeepSeek's own upstream for prompt caching and catalog
# pricing, while allowing another privacy-compatible same-model endpoint if the
# preferred host is unavailable.
# Unlike the three keys above, an unset OPENROUTER_API_KEY defaults to "" and
# is never required to boot. Leaving it blank keeps openrouter cataloged but
# unreachable — exactly like a placeholder key on the other three. It stays
# inert unless you also add "openrouter" to LLM_PROVIDER_PRIORITY below (see
# docs/RUNBOOK.md §8.5 and docs/evals/ROUTE_PROMOTION.md before doing that in
# production — the flip also moves the judge/critic/eval model, not just
# generation, and the pinned-pool preflight must pass first).
OPENROUTER_API_KEY=

# Server-owned provider precedence; the first configured + circuit-closed
# provider wins. Falling back to a cheaper platform is an env change only: set
# this to "google,anthropic,openai" and restore a real GOOGLE_API_KEY. No
# code change. For a staged OpenRouter migration, use
# "openrouter,anthropic,openai,google" so open-weight generation is primary but
# direct-provider routes remain independent fallbacks.
LLM_PROVIDER_PRIORITY=anthropic,openai,google

# Security
ENCRYPTION_MASTER_KEY=placeholder-encryption-master-key
CSRF_SECRET=placeholder-csrf-secret

# GitHub OAuth App (Phase 13) — leave blank to disable the legacy GitHub export
# integration. When blank, GET /auth/github returns 503.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App — Living System of Record (Phase 21). Leave all blank to keep the
# App OFF and fall back to the Phase-13 OAuth path. The App is "enabled" when
# GITHUB_APP_ID + GITHUB_APP_SLUG are set; in production (ENVIRONMENT=production)
# validate_production_settings() then also REQUIRES GITHUB_APP_PRIVATE_KEY and
# GITHUB_APP_WEBHOOK_SECRET (an empty private key fails startup).
#
# GITHUB_APP_ID            — GitHub's numeric App id; the App-JWT `iss`.
# GITHUB_APP_SLUG          — the App's public slug; builds the install URL.
# GITHUB_APP_PRIVATE_KEY   — RS256 PEM that signs the short-lived (exp <= 600s)
#                            App JWT. A SECRET-MANAGER value; never stored in the
#                            DB and never logged. Paste the full PEM (newlines
#                            preserved) or a single-line PEM with literal \n.
# GITHUB_APP_WEBHOOK_SECRET / _PREV — HMAC secrets for X-Hub-Signature-256.
#                            BOTH are accepted during a rotation window (set the
#                            old one in _PREV while rotating). See RUNBOOK §12.2.
# GITHUB_APP_CLIENT_ID / _SECRET — optional identity-OAuth pair (user login on
#                            top of the App install).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_WEBHOOK_SECRET_PREV=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Local Docker development only: the Smee channel configured as the dev GitHub
# App's webhook URL. docker-compose forwards it to the signed webhook endpoint.
# Leave blank in production, where GitHub calls the public HTTPS API directly.
GITHUB_WEBHOOK_PROXY_URL=

# Observability
METRICS_TOKEN=
SENTRY_DSN=
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_TOKEN=

# LLM observability (optional)
# Leave LANGFUSE_SECRET_KEY blank to disable the Langfuse integration entirely.
# When blank, the Langfuse SDK is never imported and zero network traffic is
# sent to a Langfuse host. The application behaves identically with or without
# these variables configured.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROMPT_CACHE_TTL=300
# Required in production only when LANGFUSE_SECRET_KEY is set. Setting this to
# true acknowledges that prompts and model outputs may be sent to Langfuse after
# secret-shaped redaction.
LANGFUSE_CONTENT_CAPTURE_ACK=false

# Payments — the Stripe runtime was decommissioned in Phase 22 (T-308). New
# checkout uses Razorpay only (configured below). The stripe_credit_packs /
# stripe_webhook_events audit tables and their backfilled rows are retained, but
# no STRIPE_* environment variables are read anymore — a Stripe-shaped webhook is
# answered with {"status": "ignored_provider_disabled"} and no DB write.

# Legacy Lemon Squeezy settlement only. Leave blank if there are no historical
# Lemon purchases. These settings cannot enable new checkout; retain credentials
# and webhook secrets only where old purchases still need refund settlement.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_WEBHOOK_SECRET_PREV=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_PRICE_CENTS=1500
LEMONSQUEEZY_CURRENCY=USD
LEMONSQUEEZY_CREDITS_PER_PURCHASE=200
LEMONSQUEEZY_CREDIT_VALIDITY_DAYS=30
LEMONSQUEEZY_SUCCESS_URL=http://localhost:5173/billing
LEMONSQUEEZY_TEST_MODE=true
LEMONSQUEEZY_CHECKOUT_TTL_MINUTES=30
LEMONSQUEEZY_API_BASE=https://api.lemonsqueezy.com
LEMONSQUEEZY_RECONCILE_MAX_CALLS_PER_RUN=200

# New purchases use Razorpay only. The kill switch gates new checkout; existing
# signed payment/refund/dispute events and provider recovery continue settling.
# Production requires PAYMENT_PROVIDER=razorpay. Enable only after completing
# docs/PAYMENT_LAUNCH_VERIFICATION.md on staging and checking live configuration.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=razorpay

# Razorpay billing — the payment gateway for new credit purchases,
# via hosted Payment Links. Leave RAZORPAY_KEY_ID / _KEY_SECRET blank to keep it
# unconfigured. When configured — active or not, because its webhook route
# always processes — production (ENVIRONMENT=production) REQUIRES:
# RAZORPAY_WEBHOOK_SECRET, an HTTPS RAZORPAY_SUCCESS_URL, positive
# price/credits/validity, a non-empty currency, a LIVE key (rzp_live_… — the
# LEMONSQUEEZY_TEST_MODE analogue; Razorpay events carry no test-mode flag, the
# key prefix is the environment), and RAZORPAY_CHECKOUT_TTL_MINUTES >= 16
# (Razorpay rejects payment-link expiries under ~15 minutes).
#
# RAZORPAY_WEBHOOK_SECRET / _PREV — HMAC secrets for the X-Razorpay-Signature
#   header. BOTH are accepted during a rotation window (set the old one in _PREV).
# RAZORPAY_PRICE_CENTS is integer minor units — paise for INR: 154900 = ₹1549.00.
#   NOT a naive conversion of LEMONSQUEEZY_PRICE_CENTS: Razorpay is not a
#   Merchant of Record, so 18% GST comes out of this gross on our side. ₹1549
#   nets ~₹1313 ≈ $14.9 — parity with the $15.00 USD price.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET_PREV=
RAZORPAY_PRICE_CENTS=154900
RAZORPAY_CURRENCY=INR
RAZORPAY_CREDITS_PER_PURCHASE=200
RAZORPAY_CREDIT_VALIDITY_DAYS=30
RAZORPAY_SUCCESS_URL=http://localhost:5173/billing
RAZORPAY_CHECKOUT_TTL_MINUTES=30
RAZORPAY_API_BASE=https://api.razorpay.com
RAZORPAY_RECONCILE_MAX_CALLS_PER_RUN=200
RAZORPAY_RECOVERY_ATTEMPTS_PER_RUN=50
RAZORPAY_RECONCILE_LOOKBACK_DAYS=180

# Billing admin allowlist (Phase 22 — T-302). Comma-separated emails authorised
# to issue billing admin corrections. The codebase has no role column, so this is
# the ONLY admin authorization surface — blank means no admin (the endpoint 403s
# for everyone). e.g. ADMIN_USER_EMAILS=ops@thought2build.com,founder@thought2build.com
ADMIN_USER_EMAILS=

# App
ENVIRONMENT=development
MAX_ACTIVE_WORKSPACES_PER_USER=50
