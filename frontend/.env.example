VITE_API_URL=http://localhost:8000
VITE_SENTRY_DSN=
# Unified branded loader / animated squirrel (issue #21). Enabled by default on
# every loading surface (incl. all generation overlays). Set to "false" to opt
# back out to the legacy per-surface loaders; any other value keeps it on.
VITE_BRANDED_LOADERS=
# Vercel Web Analytics (cookieless page views). Only the exact literal "true"
# injects the script; also enable Web Analytics on the Vercel project that owns
# the domain (thought2build-marketing serves /_vercel/insights/* on the apex).
VITE_ANALYTICS_ENABLED=
